{
  "hosting": {
    "public": "firebase-hosting-redirect",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/",
        "destination": "https://amissori-coder.github.io/BOLLETTINO/",
        "type": 302
      },
      {
        "source": "/**",
        "destination": "https://amissori-coder.github.io/BOLLETTINO/",
        "type": 302
      }
    ]
  }
}
